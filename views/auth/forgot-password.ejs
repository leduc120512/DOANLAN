<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quen mat khau</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #f0f4ff 0%, #e6e9ff 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .auth-container {
      background: white;
      width: 100%;
      max-width: 440px;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      background: #3b82f6;
      color: white;
      padding: 32px 24px 24px;
      text-align: center;
    }

    .header h1 {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .header p {
      font-size: 15px;
      opacity: 0.9;
      line-height: 1.5;
    }

    .form-body {
      padding: 32px 24px 40px;
    }

    .message {
      padding: 12px 16px;
      margin-bottom: 24px;
      border-radius: 0 6px 6px 0;
      font-size: 15px;
      line-height: 1.5;
    }

    .error-message {
      background: #fef2f2;
      border-left: 4px solid #ef4444;
      color: #991b1b;
    }

    .success-message {
      background: #ecfdf5;
      border-left: 4px solid #10b981;
      color: #065f46;
    }

    .form-group {
      margin-bottom: 24px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #374151;
      font-size: 15px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      font-size: 16px;
      border: 2px solid #d1d5db;
      border-radius: 10px;
      outline: none;
      transition: all 0.2s;
    }

    input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      font-size: 17px;
      font-weight: 600;
      color: white;
      background: #3b82f6;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.25s;
    }

    .btn-submit:hover {
      background: #2563eb;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.25);
    }

    .auth-link {
      color: #3b82f6;
      font-weight: 600;
      text-decoration: none;
    }

    .auth-link:hover {
      text-decoration: underline;
    }

    .bottom-link {
      text-align: center;
      margin-top: 24px;
      color: #4b5563;
      font-size: 15px;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="header">
      <h1>Quen mat khau</h1>
      <p>Nhap email tai khoan de nhan lien ket dat lai mat khau</p>
    </div>

    <div class="form-body">
      <% if (error) { %>
        <div class="message error-message"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="message success-message"><%= success %></div>
      <% } %>

      <form method="POST" action="/auth/forgot-password">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="example@gmail.com"
            value="<%= typeof email !== 'undefined' ? email : '' %>"
            required
            autocomplete="email"
          >
        </div>

        <button type="submit" class="btn-submit">Gui lien ket</button>
      </form>

      <div class="bottom-link">
        Da nho mat khau?
        <a class="auth-link" href="/auth/login">Dang nhap</a>
      </div>
    </div>
  </div>
</body>
</html>
